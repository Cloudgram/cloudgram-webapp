        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^15.15.0",
        "react-refresh": "^0.17.0",
        "sass-embedded": "^1.83.4",
        "typescript": "5.7",
        "typescript-eslint": "^8.32.0",
        "vite": "^6.0.5"
    }
}
