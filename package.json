    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "docker:remove-old": "for /f \"tokens=*\" %i in ('docker ps -aq --filter \"ancestor=cloudgram-web\"') do docker rm -f %i || echo No old container found & for /f \"tokens=*\" %j in ('docker images -q cloudgram-web') do docker rmi -f %j || echo No old image found",
        "docker:build": "docker build -t cloudgram-web --target=development .",
        "docker:run": "docker run -p 5174:5174 cloudgram-web"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.6.1",
        "@tanstack/react-query": "^5.69.0",
        "@types/node": "^22.15.2",
        "axios": "^1.9.0",
        "gsap": "^3.12.7",
        "js-cookie": "^3.0.5",
        "react": "^18.3.1",
        "react-code-input": "^3.10.1",
        "react-dom": "^18.3.1",
        "react-js-loader": "^0.1.3",
        "react-redux": "^9.2.0",
        "react-router-dom": "^7.1.5",
        "redux": "^5.0.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@types/js-cookie": "^3.0.6",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@types/react-redux": "^7.1.34",
